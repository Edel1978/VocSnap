<!-- Startseite passend auf einen Bildschirm, bunte 3D-Symbole. -->
<header class="flex items-center justify-between pt-3">
  <div class="flex items-center gap-2"><i data-snappy class="w-10"></i><div><p class="text-[11px] font-semibold text-slate-500">Mo, 26. Oktober</p><h1 class="font-display text-[22px] leading-tight font-semibold">Hallo Lena!</h1></div></div>
  <span class="flex size-10 items-center justify-center rounded-full bg-orange-100 text-xl shadow-[0_0_0_3px_#fff]">🐝</span>
</header>
<section class="mt-3 rounded-[26px] bg-gradient-to-br from-indigo-500 via-indigo-600 to-indigo-700 p-4 text-white shadow-[0_14px_30px_-12px_rgb(79_70_229/0.7)]">
  <div class="flex items-center gap-3.5">
    <div class="relative size-16 shrink-0"><svg viewBox="0 0 100 100" class="size-full -rotate-90"><circle cx="50" cy="50" r="42" fill="none" stroke="rgb(255 255 255/.2)" stroke-width="11"/><circle cx="50" cy="50" r="42" fill="none" stroke="#FDE68A" stroke-width="11" stroke-linecap="round" stroke-dasharray="264" stroke-dashoffset="176"/></svg>
      <span class="absolute inset-0 flex flex-col items-center justify-center leading-none"><b class="font-display text-lg">7</b><span class="text-[9px] text-indigo-200">von 20</span></span></div>
    <div><p class="text-[11px] font-extrabold tracking-widest text-indigo-200 uppercase">Heute dran</p><p class="font-display text-[28px] leading-none font-bold">3 Wörter</p><p class="mt-0.5 text-xs text-indigo-100">ca. 2 Minuten</p></div>
  </div>
  <span class="mt-3 flex items-center justify-center gap-2 rounded-2xl bg-orange-400 py-3 font-display text-lg font-bold text-indigo-950 shadow-press"><i data-i="play"></i> Weiterlernen</span>
</section>
<section class="mt-2.5 rounded-3xl bg-white p-3 shadow-card">
  <div class="flex items-center gap-2.5">
    <div class="flex items-center gap-0.5"><img src="fluent/fire_3d.png" class="size-7"><b class="font-display text-2xl leading-none">3</b></div>
    <div class="flex flex-1 justify-between">
      <span class="flex size-7 items-center justify-center rounded-full bg-orange-500 text-[10px] font-extrabold text-white">Mo</span><span class="flex size-7 items-center justify-center rounded-full bg-orange-500 text-[10px] font-extrabold text-white">Di</span><span class="flex size-7 items-center justify-center rounded-full border-[3px] border-dashed border-orange-400 text-[10px] font-extrabold text-orange-500">Mi</span><span class="flex size-7 items-center justify-center rounded-full bg-slate-100 text-[10px] font-extrabold text-slate-400">Do</span><span class="flex size-7 items-center justify-center rounded-full bg-slate-100 text-[10px] font-extrabold text-slate-400">Fr</span><span class="flex size-7 items-center justify-center rounded-full bg-slate-100 text-[10px] font-extrabold text-slate-400">Sa</span><span class="flex size-7 items-center justify-center rounded-full bg-slate-100 text-[10px] font-extrabold text-slate-400">So</span>
    </div>
    <span class="rounded-full bg-indigo-100 px-2 py-0.5 font-display text-sm font-bold text-indigo-700">Lv 7</span>
  </div>
  <div class="mt-2.5 flex items-center gap-2.5 rounded-2xl bg-gradient-to-r from-amber-100 to-orange-100 px-2.5 py-2">
    <img src="fluent/bullseye_3d.png" class="size-7">
    <span class="min-w-0 flex-1"><span class="flex items-baseline justify-between"><b class="font-display text-[13px]">Snappys Aufgabe: 5 richtig am Stück</b><span class="text-[11px] font-bold text-orange-600">+20 XP</span></span>
    <span class="mt-1 flex items-center gap-2"><span class="block h-1.5 flex-1 overflow-hidden rounded-full bg-white"><span class="block h-full w-2/5 rounded-full bg-orange-400"></span></span><span class="text-[10px] font-bold text-slate-600">2/5</span></span></span>
  </div>
</section>
<div class="mt-2.5 grid grid-cols-2 gap-2.5">
  <a class="relative flex items-center gap-2.5 overflow-hidden rounded-3xl bg-gradient-to-br from-sky-400 to-sky-600 p-3 text-white"><img src="fluent/check_mark_button_3d.png" class="size-10 drop-shadow"><span><b class="block font-display leading-tight">Vokabeltest</b><span class="text-[11px] font-semibold opacity-90">in 2 Tagen</span></span><span class="absolute -right-1 -bottom-4 font-display text-6xl font-bold opacity-20">2</span></a>
  <a class="relative flex items-center gap-2.5 overflow-hidden rounded-3xl bg-gradient-to-br from-orange-400 to-orange-600 p-3 text-white"><img src="fluent/spiral_calendar_3d.png" class="size-10 drop-shadow"><span><b class="block font-display leading-tight">Klassenarbeit</b><span class="text-[11px] font-semibold opacity-90">in 12 Tagen</span></span><span class="absolute -right-2 -bottom-4 font-display text-6xl font-bold opacity-20">12</span></a>
  <a class="relative flex items-center gap-2.5 overflow-hidden rounded-3xl bg-gradient-to-br from-rose-400 to-pink-600 p-3 text-white"><img src="fluent/counterclockwise_arrows_button_3d.png" class="size-10 drop-shadow"><span><b class="block font-display leading-tight">3 Fehler</b><span class="text-[11px] font-semibold opacity-90">ausbügeln</span></span></a>
  <a class="relative flex items-center gap-2.5 overflow-hidden rounded-3xl bg-gradient-to-br from-violet-500 to-indigo-700 p-3 text-white"><img src="fluent/glowing_star_3d.png" class="size-10 drop-shadow"><span class="flex-1"><b class="block font-display leading-tight">Entdecker</b><span class="mt-1 block h-1.5 overflow-hidden rounded-full bg-white/25"><span class="block h-full w-1/2 rounded-full bg-amber-200"></span></span></span></a>
</div>
<section class="mt-3">
  <div class="mb-1.5 flex items-center justify-between"><h2 class="font-display text-lg font-semibold">Lektionen</h2><a class="flex items-center gap-1 rounded-full bg-indigo-600 px-3 py-1 text-sm font-bold text-white"><i data-i="plus" class="size-4"></i> Neu</a></div>
  <div class="-mx-4 flex gap-2.5 overflow-hidden px-4">
    <a class="w-40 shrink-0 rounded-3xl bg-gradient-to-br from-indigo-500 to-indigo-700 p-3 text-white"><span class="text-[10px] font-extrabold opacity-80">EN → DE</span><b class="block truncate font-display leading-tight">Unit 3 – At school</b><span class="mt-2 block h-1.5 overflow-hidden rounded-full bg-white/25"><span class="block h-full w-[38%] rounded-full bg-white"></span></span><span class="mt-1 block text-[11px] opacity-90">8 Wörter · 38 %</span></a>
    <a class="w-40 shrink-0 rounded-3xl bg-gradient-to-br from-pink-500 to-pink-700 p-3 text-white"><span class="text-[10px] font-extrabold opacity-80">FR → DE</span><b class="block truncate font-display leading-tight">Leçon 2</b><span class="mt-2 block h-1.5 overflow-hidden rounded-full bg-white/25"><span class="block h-full w-1/4 rounded-full bg-white"></span></span><span class="mt-1 block text-[11px] opacity-90">8 Wörter · 25 %</span></a>
    <a class="flex w-24 shrink-0 flex-col items-center justify-center rounded-3xl border-2 border-dashed border-slate-300 text-xs font-bold text-slate-500"><i data-i="plus"></i>Neu</a>
  </div>
</section>
