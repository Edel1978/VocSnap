<!-- Einstellungen Lernen: Stepper statt Eingabefeld, Profi-Einstellungen eingeklappt. -->
<div class="flex items-center gap-2 pt-4"><span class="text-indigo-600"><i data-i="back"></i></span><h1 class="font-display text-3xl font-semibold">Lernen</h1></div>
<section class="mt-4 rounded-3xl bg-white p-4 shadow-card">
  <h2 class="font-display text-lg font-semibold">Tagesziel</h2><p class="text-sm text-slate-500">Gewusste Wörter pro Tag</p>
  <div class="mt-3 flex items-center justify-between rounded-2xl bg-slate-50 p-2"><span class="flex size-11 items-center justify-center rounded-xl bg-white text-2xl font-bold text-indigo-600 shadow-card">−</span><b class="font-display text-3xl">20</b><span class="flex size-11 items-center justify-center rounded-xl bg-white text-2xl font-bold text-indigo-600 shadow-card">+</span></div>
  <div class="mt-2 flex gap-1.5 text-xs font-bold"><span class="rounded-full bg-slate-100 px-2.5 py-1">10 locker</span><span class="rounded-full bg-indigo-600 px-2.5 py-1 text-white">20 normal</span><span class="rounded-full bg-slate-100 px-2.5 py-1">40 ehrgeizig</span></div>
</section>
<section class="mt-3 rounded-3xl bg-white p-4 shadow-card">
  <h2 class="font-display text-lg font-semibold">Karteikarten</h2>
  <div class="mt-2 grid grid-cols-2 gap-2"><span class="rounded-xl bg-indigo-600 py-2.5 text-center text-sm font-bold text-white shadow-press-indigo">Umdrehen</span><span class="rounded-xl bg-slate-100 py-2.5 text-center text-sm font-bold">Wischen</span></div>
</section>
<section class="mt-3 flex items-center gap-3 rounded-3xl bg-white p-4 shadow-card"><span class="flex size-10 items-center justify-center rounded-xl bg-violet-100 text-violet-600"><i data-i="mic" class="size-5"></i></span><span class="flex-1"><b class="block">Aussprache üben</b><span class="text-sm text-slate-500">Zusätzlicher Lernmodus</span></span><span class="relative h-7 w-12 rounded-full bg-slate-300"><span class="absolute top-1 left-1 size-5 rounded-full bg-white"></span></span></section>
<section class="mt-3 flex items-center justify-between rounded-3xl bg-white p-4 shadow-card"><span><b class="block">Für Profis</b><span class="text-sm text-slate-500">Reihenfolge der Lernmodi, Tage je Fach</span></span><i data-i="chevron" class="size-5 rotate-90 text-slate-400"></i></section>
