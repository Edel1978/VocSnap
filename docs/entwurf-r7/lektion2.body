<!-- Lektion: Wörter ohne rote Kreuze (Antippen = bearbeiten/löschen), Fach als Farbpunkt, Hinzufügen als 4 Kacheln. -->
<div class="flex items-center justify-between pt-4"><span class="flex size-10 items-center justify-center rounded-full bg-white shadow-card text-indigo-600"><i data-i="back" class="size-5"></i></span><span class="flex size-10 items-center justify-center rounded-full bg-white shadow-card text-indigo-600"><i data-i="pencil" class="size-5"></i></span></div>
<section class="mt-3 rounded-[28px] bg-gradient-to-br from-indigo-500 to-indigo-800 p-5 text-white">
  <p class="text-xs font-extrabold tracking-widest uppercase opacity-80">Englisch → Deutsch</p><h1 class="mt-1 font-display text-3xl font-bold">Unit 3 – At school</h1>
  <div class="mt-3 flex gap-1">
    <span class="h-2.5 flex-[3] rounded-full bg-rose-300"></span><span class="h-2.5 flex-[2] rounded-full bg-amber-300"></span><span class="h-2.5 flex-[2] rounded-full bg-emerald-300"></span><span class="h-2.5 flex-1 rounded-full bg-emerald-500"></span>
  </div>
  <p class="mt-1.5 text-xs opacity-90">3 neu · 2 wackelig · 3 sicher</p>
  <a class="mt-4 flex items-center justify-center gap-2 rounded-2xl bg-orange-400 py-3.5 font-display text-lg font-bold text-indigo-950 shadow-press"><img src="fluent/rocket_3d.png" class="size-7"> Lektion lernen</a>
</section>
<div class="mt-4 grid grid-cols-4 gap-2">
