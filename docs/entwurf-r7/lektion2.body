  <a class="flex flex-col items-center gap-1 rounded-2xl bg-white py-3 text-xs font-bold shadow-card"><span class="flex size-11 items-center justify-center rounded-2xl bg-orange-100"><img src="fluent/sparkles_3d.png" class="size-8"></span>KI</a>
  <a class="flex flex-col items-center gap-1 rounded-2xl bg-white py-3 text-xs font-bold shadow-card"><span class="flex size-11 items-center justify-center rounded-2xl bg-emerald-100"><img src="fluent/memo_3d.png" class="size-8"></span>Liste</a>
  <a class="flex flex-col items-center gap-1 rounded-2xl bg-white py-3 text-xs font-bold shadow-card"><span class="flex size-11 items-center justify-center rounded-2xl bg-indigo-100"><img src="fluent/pencil_3d.png" class="size-8"></span>Tippen</a>
</div>
<section class="mt-4 rounded-3xl bg-white p-3 shadow-card">
  <div class="mb-1 flex items-center gap-2 rounded-xl bg-slate-50 px-3 py-2 text-slate-400"><i data-i="search" class="size-5"></i>8 Wörter durchsuchen</div>
  <ul class="divide-y divide-slate-100">
    <li class="flex items-center gap-3 px-1 py-2.5"><span class="size-2.5 rounded-full bg-rose-400"></span><span class="flex-1"><b class="block font-semibold">the dog</b><span class="text-sm text-slate-500">der Hund</span></span><i data-i="chevron" class="size-4 text-slate-300"></i></li>
    <li class="flex items-center gap-3 px-1 py-2.5"><span class="size-2.5 rounded-full bg-amber-400"></span><span class="flex-1"><b class="block font-semibold">the friend</b><span class="text-sm text-slate-500">der Freund</span></span><i data-i="chevron" class="size-4 text-slate-300"></i></li>
    <li class="flex items-center gap-3 px-1 py-2.5"><span class="size-2.5 rounded-full bg-emerald-500"></span><span class="flex-1"><b class="block font-semibold">the school</b><span class="text-sm text-slate-500">die Schule</span></span><i data-i="chevron" class="size-4 text-slate-300"></i></li>
    <li class="flex items-center gap-3 px-1 py-2.5"><span class="size-2.5 rounded-full bg-emerald-500"></span><span class="flex-1"><b class="block font-semibold">to swim</b><span class="text-sm text-slate-500">schwimmen</span></span><i data-i="chevron" class="size-4 text-slate-300"></i></li>
  </ul>
</section>
